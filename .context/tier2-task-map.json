{
  "description": "Tier 2 文件映射 - 根据任务类型选择加载",
  "task_file_map": {
    "homepage": [
      "src/components/home/*.tsx",
      "src/app/[locale]/page.tsx",
      "tests/e2e/homepage.spec.ts"
    ],
    "blog": [
      "src/app/[locale]/blog/**",
      "src/data/blog.ts",
      "tests/e2e/blog.spec.ts"
    ],
    "learning": [
      "src/app/[locale]/learn/**",
      "src/data/learning-path.ts"
    ],
    "skills": [
      "src/app/[locale]/skills/**",
      "src/data/skills.ts",
      "tests/e2e/skills.spec.ts",
      "src/components/skills/SkillBrowser.tsx"
    ],
    "tutorials": [
      "src/app/[locale]/tutorials/**",
      "src/data/tutorials.ts",
      "tests/e2e/tutorials.spec.ts",
      "src/components/tutorials/TutorialList.tsx"
    ],
    "i18n": [
      "src/i18n/en.json",
      "src/i18n/zh.json",
      "src/i18n/routing.ts",
      "src/middleware.ts"
    ],
    "seo": [
      "src/app/sitemap.ts",
      "src/app/robots.ts",
      "src/app/feed.xml/route.ts",
      "src/components/seo/*.tsx",
      "tests/e2e/seo.spec.ts"
    ],
    "ui_components": [
      "src/components/ui/*.tsx",
      "src/components/ui/index.ts"
    ],
    "layout": [
      "src/components/layout/Header.tsx",
      "src/components/layout/Footer.tsx",
      "src/app/[locale]/layout.tsx",
      "tests/e2e/navigation.spec.ts"
    ],
    "database": [
      "src/lib/db/index.ts",
      "src/lib/db/schema.ts",
      "src/app/api/cron/sync/route.ts",
      "src/app/api/tutorials/data/route.ts"
    ],
    "testing": [
      "playwright.config.ts",
      "tests/e2e/*.spec.ts"
    ],
    "harness": [
      "AGENTS.md",
      "progress.json",
      "feature_list.json",
      "scripts/lint-structure.js",
      "eslint-rules/*.js"
    ]
  }
}
