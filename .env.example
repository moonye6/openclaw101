# OpenClaw 101 — 环境变量配置
# 复制此文件为 .env.local 并填入真实值

# ============ 必需 ============

# Vercel Cron 鉴权密钥（用于 /api/cron/sync 定时任务鉴权）
CRON_SECRET=your-cron-secret-here

# ============ 可选 ============

# Google Analytics 跟踪 ID（默认值已内置，可覆盖）
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# 站点基础 URL（用于生成 RSS feed 等绝对链接）
# BASE_URL=https://openclaw101.vip

# Node.js 环境（Vercel 自动设置，本地开发默认 development）
# NODE_ENV=development

# ============ GSC API 同步 (CP-3, 每周拉一次) ============
# 用于 `pnpm sync:gsc` — 详细安装步骤见 docs/seo/gsc-setup.md
# 服务账户 JSON 路径（不要 commit！建议放 ~/.gsc/ 下）
# GSC_SERVICE_ACCOUNT_KEY_PATH=~/.gsc/service-account.json
# GSC 站点标识：domain property 用 sc-domain:openclaw101.vip
# GSC_SITE_URL=sc-domain:openclaw101.vip
# 可选：拉取窗口（默认 28 天）
# GSC_REPORT_DAYS=28
